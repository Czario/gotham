# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/
# Database name
DATABASE_NAME=normalize_data

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=sec:filings:10kq
REDIS_DEAD_LETTER_QUEUE=sec:filings:dlq:10kq
REDIS_MAX_ATTEMPTS=3
REDIS_RETRY_DELAY_SECONDS=5

# Path where HTML filings will be downloaded, compressed, and stored
# Files will be named by accession number (e.g., aapl-20240928.htm.gz)
SEC_HTML_DOWNLOAD_PATH=/Users/aijaz/sec_html_filings

# Number of companies to process in parallel (default: 1 = sequential).
# Recommended: 3–5. All workers share an 8 req/s SEC rate-limit bucket.
SEC_WORKERS=3
