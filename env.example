# =============================================================================
# SEC Data Scraper - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and configure your specific values.
# All variables below are REQUIRED. The application will raise an error if
# any are missing.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/
# Database name (used by both extraction and normalization layers)
DATABASE_NAME=normalize_data

# =============================================================================
# DATA PATHS AND DIRECTORIES
# =============================================================================

# Path where HTML filings will be downloaded, compressed, and stored
# Files will be named by accession number (e.g., aapl-20240928.htm.gz)
SEC_HTML_DOWNLOAD_PATH=/path/to/sec_html_filings

# XBRL zip replay cache — downloaded XBRL zips are saved here permanently
XBRL_ZIP_CACHE_PATH=/path/to/xbrl_zip_cache