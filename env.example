# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/
# Database name
DATABASE_NAME=normalize_data

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=sec:filings:10kq
REDIS_DEAD_LETTER_QUEUE=sec:filings:dlq:10kq
REDIS_MAX_ATTEMPTS=3
REDIS_RETRY_DELAY_SECONDS=5

# Path where HTML filings will be downloaded, compressed, and stored
# Files will be named by accession number (e.g., aapl-20240928.htm.gz)
SEC_HTML_DOWNLOAD_PATH=/Users/aijaz/sec_html_filings

# Number of companies to process in parallel (default: 1 = sequential).
# Recommended: 3–5. All workers share an 8 req/s SEC rate-limit bucket.
SEC_WORKERS=3
# Kill switch for the whole agent hierarchy pass (0 = always deterministic).
HIERARCHY_AGENT_ENABLED=1

# Retry a timed-out/failed agent LLM call once before giving up.
LLM_CHAT_MAX_RETRIES=1

# ── Save gate ─────────────────────────────────────────────────────────────────
# 1 (strict) = never write a filing that still has unresolved high-severity
#   validation findings (the whole filing is skipped).
# 0 (advisory, default) = findings are recorded and provably-wrong concepts are
#   still excluded by the validation ceiling, but a filing is NEVER blocked.
STRICT_ACCURACY=0

# ─── Concept resolution: the agent decides whether two tags are the same ────
# Fliers re-tag the SAME line item across accounting-standard eras (ASC 606
# revenue, ASU 2016-18 restricted cash, continuing-operations variants). When a
# filing introduces a concept NAME the company never used, this agent-LIM decides
# whether it is an alias of a stored concept (values merge onto the existing row,
# no duplicate created) or a genuinely new line item. Decisions are cached in the
# target DB's concept_aliases collection, so repeat filings cost zero LLM calls.
# Kill switch (0 = every new tag becomes its own concept, historical behaviour).
CONCEPT_AGENT_ENABLED=1

# What happens when the agent cannot decide for a statement:
#   fallback (default) — undecided new concepts are created as their own rows
#                        (historical behaviour; ingestion never stalls).
#   block              — the run fails and nothing is persisted until the
#                        agent decides.
CONCEPT_AGENT_FAILURE_POLICY=fallback

# Newest-period concept promotion (independent kill switch).
# The agent decides only whether two tags mean the SAME line item.  Which tag
# NAME survives is decided deterministically by period: when the incoming
# filing's tag belongs to a NEWER period than the newest period the stored
# concept has a value for, the incoming tag wins — the stored concept's values
# are MOVED onto it (never deleted) and the old concept ROW is hard-deleted.
# Otherwise the incoming values attach to the stored concept (no rename).
# Scope is a single form type: a 10-K run never touches 10-Q data, and vice
# versa.  0 disables promotion entirely (attaches still happen).
CONCEPT_PROMOTION_ENABLED=1

# ── Guidance extraction (forward-looking MD&A) ──────────────────────────────
# 0 disables the guidance pass entirely: no LLM call and no guidance_values
# writes (the two guidance graph nodes short-circuit).
GUIDANCE_ENABLED=1
# 0 keeps the deterministic pipeline but skips only the guidance LLM pass.
GUIDANCE_LLM_ENABLED=1
