# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
wheels/
*.egg
MANIFEST

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ─── Environment / secrets ────────────────────────────────────────────────────
# Keep env.example (template) but ignore the real .env file
.env
.env.*
!.env.example

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Testing / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
# Extraction run logs at repo root (e.g. _extract_jnj.log, _extract_3.log)
_extract*.log

# ─── Database ─────────────────────────────────────────────────────────────────
*.db
*.sqlite3

# ─── Temporary / scratch files ────────────────────────────────────────────────
*.tmp
*.temp

# ─── Ad-hoc debug / one-off scripts (not part of the codebase) ───────────────
# Matches files like _debug_db.py, _debug_something.py
_debug_*.py
# Root-level one-off analysis / patch scripts
/analyze_*.py
/create_*.py
/*_patch.py
/*_improvements.py
/*_instructions.py

# ─── Runtime user input files ─────────────────────────────────────────────────
# stocks_download.txt is a per-user runtime input; use stocks_download.txt.example
# as the committed template (if desired)
stocks_download.txt

# ─── Output / generated data files ───────────────────────────────────────────
output.json
*_income.json
dimensional_*.json
*.backup.json
*_backup_*.json

